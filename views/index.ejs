<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message Board</title>
</head>
<body>
    <h1>Mini Message Board</h1>
    <% messages.forEach((message)=> { %>
        <li>
            <p><%= message.user %></p>
            <p><%= message.text %></p>
            <p><%= message.added %></p>
        </li>
    <%})%>
</body>
</html>